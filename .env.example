# Kovra server configuration. Copy to .env and fill in.
# Market data is read directly from the chain node. Only the AI agent needs a key.

# Onchain RWA data (Robinhood Chain, chainId 4663) — the single data source.
# Enabled by default; KOVRA_CHAIN_ENABLED=false turns it off.
KOVRA_CHAIN_ENABLED=true
KOVRA_CHAIN_WS=ws://40.160.13.247:8546
KOVRA_CHAIN_HTTP=http://40.160.13.247:8545
PORT=8787

# AI agent: OpenAI SDK through OpenRouter (https://openrouter.ai/keys).
# Without a key the agent endpoint answers 503 and the UI says so.
OPENROUTER_API_KEY=
# Any OpenRouter model id. The id stays server-side; it is never sent to the UI.
KOVRA_LLM_MODEL=deepseek/deepseek-chat

# WalletConnect (QR pairing for mobile wallets). Free project id:
# https://cloud.reown.com -> create project -> copy the Project ID.
VITE_WALLETCONNECT_PROJECT_ID=
