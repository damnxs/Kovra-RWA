# Kovra server configuration. Copy to .env and fill in.
# The API key never reaches the browser bundle — server-side only.

MARKET_DATA_PROVIDER=finnhub
FINNHUB_API_KEY=
MARKET_DATA_MODE=development
PUBLIC_DISPLAY_APPROVED=false
DEMO_MODE=false
# Onchain RWA data (Robinhood Chain, chainId 4663) — real public data, no key.
# Enabled by default; KOVRA_CHAIN_ENABLED=false turns it off.
KOVRA_CHAIN_ENABLED=true
KOVRA_CHAIN_WS=ws://40.160.13.247:8546
KOVRA_CHAIN_HTTP=http://40.160.13.247:8545
